apiVersion: v1
kind: Secret
metadata:
  name: postgres-read-secret
  namespace: banking-dev
data:
  # Values are base64-encoded. To encode: echo -n "myvalue" | base64
  POSTGRES_DB: YmFua2luZ19yZWFk     # banking_read
  POSTGRES_USER: cG9zdGdyZXM=       # postgres
  POSTGRES_PASSWORD: cG9zdGdyZXM=   # postgres
