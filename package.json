{
  "name": "banking-event-sourcing",
  "version": "0.1.0",
  "scripts": {
    "dev": "bun run --watch server.ts",
    "start": "bun run server.ts",
    "migrate": "bun run scripts/migrate.ts",
    "test": "bun test",
    "test:unit:coverage": "bun test tests/unit --coverage --coverage-reporter=lcov --coverage-dir=coverage",
    "test:integration": "TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5433/banking_test TEST_READ_DATABASE_URL=postgres://postgres:postgres@localhost:5435/banking_read_test TEST_REDIS_URL=redis://localhost:6380 TEST_KAFKA_BROKERS=localhost:9093 bun test tests/integration",
    "db:generate:read": "drizzle-kit generate",
    "db:migrate:read": "bun run src/infrastructure/postgres/read/migrate.ts",
    "k8s:setup:full": "./scripts/setup.sh",
    "k8s:cluster:create": "kind create cluster --config kind-config.yaml --name banking",
    "k8s:cluster:delete": "kind delete cluster --name banking",
    "k8s:setup": "./scripts/setup-metallb.sh",
    "k8s:image:load": "docker build -t banking-event-sourcing:latest . && kind load docker-image banking-event-sourcing:latest --name banking",
    "k8s:deploy": "kubectl apply -f k8s/postgres/ -f k8s/postgres-read/ -f k8s/redis/ -f k8s/kafka/ -f k8s/app/ -n banking",
    "k8s:undeploy": "kubectl delete -f k8s/postgres/ -f k8s/postgres-read/ -f k8s/redis/ -f k8s/kafka/ -f k8s/app/ -n banking --ignore-not-found",
    "k8s:status": "kubectl get all -n banking",
    "k8s:logs": "kubectl logs -f deployment/banking-app -n banking",
    "k8s:restart": "kubectl rollout restart deployment/banking-app -n banking && kubectl rollout status deployment/banking-app -n banking",
    "monitoring:install": "helm repo add prometheus-community https://prometheus-community.github.io/helm-charts && helm repo update && helm upgrade --install kube-prometheus-stack prometheus-community/kube-prometheus-stack -n monitoring --create-namespace --values k8s/monitoring/prometheus-values.yaml --wait --timeout 5m",
    "monitoring:collector": "kubectl apply -f k8s/monitoring/otel-collector/",
    "monitoring:dashboard": "kubectl apply -f k8s/monitoring/grafana-dashboard-banking.yaml",
    "monitoring:grafana": "kubectl port-forward -n monitoring svc/kube-prometheus-stack-grafana 3000:80 &",
    "monitoring:prometheus": "kubectl port-forward -n monitoring svc/kube-prometheus-stack-prometheus 9090:9090 &"
  },
  "dependencies": {
    "@elysiajs/swagger": "^1.3.1",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/core": "^2.7.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.215.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.215.0",
    "@opentelemetry/resources": "^2.7.0",
    "@opentelemetry/sdk-metrics": "^2.7.0",
    "@opentelemetry/sdk-trace-base": "^2.7.0",
    "@opentelemetry/semantic-conventions": "^1.40.0",
    "drizzle-orm": "^0.45.2",
    "elysia": "^1.4.28",
    "ioredis": "^5.10.1",
    "kafkajs": "^2.2.4",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "drizzle-kit": "^0.31.10"
  },
  "patchedDependencies": {
    "kafkajs@2.2.4": "patches/kafkajs@2.2.4.patch"
  }
}
