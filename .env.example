# ─── Server ───────────────────────────────────────────────────
PORT=3000

# ─── PostgreSQL — Write Side (Event Store) ────────────────────
DATABASE_URL=postgres://postgres:postgres@localhost:5432/banking
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5433/banking_test

# ─── PostgreSQL — Read Side (Projeções / Read Models) ─────────
READ_DATABASE_URL=postgres://postgres:postgres@localhost:5434/banking_read
TEST_READ_DATABASE_URL=postgres://postgres:postgres@localhost:5435/banking_read_test

# ─── Redis ────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
TEST_REDIS_URL=redis://localhost:6380

# ─── Event Sourcing ───────────────────────────────────────────
# Number of events after which a snapshot is saved to Redis
SNAPSHOT_THRESHOLD=50

# ─── Read Model Cache ─────────────────────────────────────────
# TTL in seconds for cached read models (balance, statement)
READ_MODEL_CACHE_TTL=60
